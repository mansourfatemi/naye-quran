<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>تیونر نوای قرآن</title>
<style>
  *{box-sizing:border-box;font-family:Tahoma,"Segoe UI",sans-serif}
  body{margin:0;background:#1a1a1a;color:#eee;min-height:100vh;display:flex;justify-content:center}
  .app{width:100%;max-width:420px;background:#1a1a1a;min-height:100vh;padding-bottom:24px}

  .tuner-header{background:#e91e63;color:#fff;padding:16px 14px;display:flex;align-items:center;box-shadow:0 3px 10px rgba(0,0,0,.3)}
  .back-btn{background:none;border:none;color:#fff;font-size:1.5em;cursor:pointer;padding:0 10px;line-height:1}
  .tuner-title{flex:1;text-align:center;font-size:1.1em;font-weight:bold;margin-left:34px}

  .mic-btn{display:block;margin:16px auto 6px;border:none;cursor:pointer;border-radius:50px;padding:12px 28px;font-size:.92em;font-weight:bold;background:#333;color:#fff;box-shadow:0 3px 10px rgba(0,0,0,.3)}
  .mic-btn.on{background:#e91e63}
  .mic-status{text-align:center;font-size:.72em;color:#777;margin-bottom:6px;padding:0 16px;line-height:1.6}

  .octave-row{display:flex;justify-content:space-between;padding:10px 18px 4px;font-size:1.05em;color:#888;direction:ltr}
  .octave-row span{width:24px;text-align:center;position:relative}
  .octave-row span.active{color:#fff}
  .octave-row span.active::before{content:'';position:absolute;top:-3px;left:50%;transform:translateX(-50%);width:30px;height:30px;border-radius:50%;background:#4CAF50;z-index:-1}

  .piano-graphic-wrap{margin:10px auto;overflow-x:auto;padding-bottom:4px}
  .piano-graphic{position:relative;height:130px;width:308px;margin:0 auto;direction:ltr}
  .pg-wkey{position:absolute;top:0;width:44px;height:130px;background:#555;border:1px solid #444;border-radius:0 0 5px 5px;transition:background .12s;cursor:pointer}
  .pg-wkey.active{background:#fff}
  .pg-bkey{position:absolute;top:0;width:26px;height:80px;background:#111;border-radius:0 0 4px 4px;z-index:5;cursor:pointer;transition:background .12s}
  .pg-bkey.active{background:#fff}

  .letter-row{display:flex;justify-content:space-between;padding:10px 18px 0;font-size:1.05em;font-weight:bold;color:#999;direction:ltr}
  .letter-row span{width:38px;text-align:center;cursor:pointer}
  .letter-row span.active{color:#fff;background:#e91e63;border-radius:50%;padding:4px 0}

  .persian-row{display:flex;justify-content:space-between;padding:8px 18px 0;direction:ltr}
  .persian-row span{width:38px;text-align:center;font-size:1.05em;color:#999;cursor:pointer}
  .persian-row span.active{color:#fff;background:#e91e63;border-radius:8px;padding:4px 0}

  .cents-wrap{width:280px;margin:26px auto 0;direction:ltr;position:relative;height:56px}
  .cents-axis{position:relative;height:30px}
  .cents-tick{position:absolute;bottom:0;width:1.5px;height:24px;background:#555}
  .cents-tick.mid{background:#777;height:28px}
  .cents-label{position:absolute;top:0;font-size:.7em;color:#888;transform:translateX(-50%)}
  .cents-needle{position:absolute;bottom:0;width:3px;height:28px;background:#e91e63;transition:left .06s linear,background .15s;left:139px}
  .cents-needle.good{background:#4CAF50}
  .cents-needle.warn{background:#FF9800}

  .qtone-hint{text-align:center;font-size:.75em;color:#26c6da;background:rgba(38,198,218,.1);border-radius:10px;padding:8px 12px;margin:14px 20px 0;display:none;line-height:1.6}
  .qtone-hint.show{display:block}

  .big-note-wrap{text-align:center;margin-top:10px}
  .big-note{font-size:2.6em;font-weight:bold;color:#e91e63;line-height:1}
  .big-cents{font-size:1.1em;color:#ddd;margin-top:4px}
  .freq-ref{font-size:.85em;color:#888;margin-top:14px;text-align:center;direction:ltr}

  .idle-msg{text-align:center;color:#777;font-size:.85em;padding:10px 20px 0}
</style>
</head>
<body>
<div class="app">
  <div class="tuner-header">
    <button class="back-btn" onclick="history.back()">&#8592;</button>
    <div class="tuner-title">تیونر نوای قرآن</div>
  </div>

  <button class="mic-btn" id="micBtn">🎙️ شروع تیونر</button>
  <div class="mic-status" id="micStatus"></div>

  <div class="octave-row" id="octaveRow"></div>

  <div class="piano-graphic-wrap">
    <div class="piano-graphic" id="pianoGraphic"></div>
  </div>

  <div class="letter-row" id="letterRow"></div>
  <div class="persian-row" id="persianRow"></div>

  <div class="cents-wrap" id="centsWrap">
    <div class="cents-axis" id="centsAxis"></div>
    <div class="cents-needle" id="centsNeedle"></div>
  </div>

  <div class="qtone-hint" id="qtoneHint"></div>

  <div class="big-note-wrap">
    <div class="big-note" id="bigNote">—</div>
    <div class="big-cents" id="bigCents">&nbsp;</div>
  </div>
  <div class="idle-msg" id="idleMsg">میکروفون را روشن کنید یا روی پیانو بزنید</div>
  <div class="freq-ref">A4 = 440 Hz</div>
  <div id="debugLine" style="text-align:center;font-size:.7em;color:#26c6da;padding:4px;direction:ltr"></div>
</div>

<script>
// ══════════════════════════════════════════════════════════
//  تیونر نوای قرآن — نسخه ۲ (AudioWorklet + Overlap)
//  معماری الهامگرفته از TarsosDSP (مدرسه تلاوت ۱)
// ══════════════════════════════════════════════════════════

function toFa(n){ return n.toString().replace(/[0-9]/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]); }

const NOTE_NAMES_FA = ['دو','دو#','ر','ر#','می','فا','فا#','سل','سل#','لا','لا#','سی'];
const NOTE_NAMES_EN = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];
const IS_SHARP = [false,true,false,true,false,false,true,false,true,false,true,false];
const WHITE_LETTER_IDX = [0,2,4,5,7,9,11];
const BLACK_AFTER_WHITE = {1:0, 3:1, 6:3, 8:4, 10:5};

// ══════════ ردیف اکتاو (۰ تا ۸) ══════════
const octaveRow = document.getElementById('octaveRow');
for(let o=0; o<=8; o++){
  const s = document.createElement('span');
  s.textContent = toFa(o);
  s.dataset.oct = o;
  octaveRow.appendChild(s);
}
function setActiveOctave(oct){
  octaveRow.querySelectorAll('span').forEach(s=>{
    s.classList.toggle('active', Number(s.dataset.oct) === oct);
  });
}

// ══════════ ردیف حروف انگلیسی + ردیف نام فارسی ══════════
const letterRow = document.getElementById('letterRow');
const persianRow = document.getElementById('persianRow');
WHITE_LETTER_IDX.forEach(idx=>{
  const s1 = document.createElement('span');
  s1.textContent = NOTE_NAMES_EN[idx];
  s1.dataset.idx = idx;
  s1.onclick = ()=> manualPlayByIdx(idx);
  letterRow.appendChild(s1);

  const s2 = document.createElement('span');
  s2.textContent = NOTE_NAMES_FA[idx];
  s2.dataset.idx = idx;
  s2.onclick = ()=> manualPlayByIdx(idx);
  persianRow.appendChild(s2);
});
function setActiveLetter(noteIdx){
  letterRow.querySelectorAll('span').forEach(s=>{
    s.classList.toggle('active', Number(s.dataset.idx) === noteIdx);
  });
  persianRow.querySelectorAll('span').forEach(s=>{
    s.classList.toggle('active', Number(s.dataset.idx) === noteIdx);
  });
}

// ══════════ گرافیک پیانو ══════════
const PG_WKEY_W = 44, PG_BKEY_W = 26;
const pianoGraphic = document.getElementById('pianoGraphic');
const pgWhiteKeys = [], pgBlackKeys = [];
WHITE_LETTER_IDX.forEach((idx,i)=>{
  const el = document.createElement('div');
  el.className = 'pg-wkey';
  el.style.left = (i*PG_WKEY_W) + 'px';
  el.onclick = ()=> manualPlayByIdx(idx);
  pianoGraphic.appendChild(el);
  pgWhiteKeys[idx] = el;
});
Object.keys(BLACK_AFTER_WHITE).forEach(k=>{
  const semiIdx = Number(k);
  const afterWhiteI = BLACK_AFTER_WHITE[semiIdx];
  const el = document.createElement('div');
  el.className = 'pg-bkey';
  el.style.left = ((afterWhiteI+1)*PG_WKEY_W - PG_BKEY_W/2 - 3) + 'px';
  el.onclick = (e)=>{ e.stopPropagation(); manualPlayByIdx(semiIdx); };
  pianoGraphic.appendChild(el);
  pgBlackKeys[semiIdx] = el;
});
function setActivePianoKey(noteIdx){
  Object.values(pgWhiteKeys).forEach(k=>k && k.classList.remove('active'));
  Object.values(pgBlackKeys).forEach(k=>k && k.classList.remove('active'));
  if(noteIdx < 0) return;
  if(IS_SHARP[noteIdx]){
    if(pgBlackKeys[noteIdx]) pgBlackKeys[noteIdx].classList.add('active');
  } else {
    if(pgWhiteKeys[noteIdx]) pgWhiteKeys[noteIdx].classList.add('active');
  }
}

// ── نواختن دستی یک نُت مرجع ──
let audioCtx = null;
function ensureCtx(){
  if(!audioCtx) audioCtx = new (window.AudioContext||window.webkitAudioContext)();
  if(audioCtx.state === 'suspended') audioCtx.resume();
  return audioCtx;
}
function playTone(freq){
  const ctx = ensureCtx();
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.type = 'triangle';
  osc.frequency.value = freq;
  gain.gain.setValueAtTime(0.0001, ctx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.35, ctx.currentTime + 0.01);
  gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 1.1);
  osc.connect(gain);
  gain.connect(ctx.destination);
  osc.start();
  osc.stop(ctx.currentTime + 1.15);
}

let lastDetectedOctave = 4;
function manualPlayByIdx(noteIdx){
  const midi = (lastDetectedOctave + 1) * 12 + noteIdx;
  const freq = 440 * Math.pow(2, (midi - 69) / 12);
  ensureCtx();
  playTone(freq);
  displayNote(noteIdx, lastDetectedOctave, 0, freq);
}

// ══════════ خطکش سِنت ══════════
function renderCentsAxis(){
  const axis = document.getElementById('centsAxis');
  axis.innerHTML = '';
  [-50,-25,0,25,50].forEach(v=>{
    const tick = document.createElement('div');
    tick.className = 'cents-tick' + (v===0 ? ' mid' : '');
    tick.style.left = ((v+50)/100*280) + 'px';
    axis.appendChild(tick);
    const lbl = document.createElement('div');
    lbl.className = 'cents-label';
    lbl.style.left = ((v+50)/100*280) + 'px';
    lbl.textContent = (v>0?'+':'') + v;
    axis.appendChild(lbl);
  });
}
renderCentsAxis();

function displayNote(noteIdx, octave, cents, freq){
  document.getElementById('idleMsg').style.display = 'none';
  lastDetectedOctave = octave;
  setActiveOctave(octave);
  setActiveLetter(noteIdx);
  setActivePianoKey(noteIdx);

  const bigNote = document.getElementById('bigNote');
  const bigCents = document.getElementById('bigCents');
  bigNote.textContent = NOTE_NAMES_FA[noteIdx];
  const roundedCents = Math.round(cents);
  bigCents.textContent = (roundedCents>0?'+':'') + toFa(Math.abs(roundedCents)).replace(/^/, roundedCents<0?'\u2212':'');

  const needle = document.getElementById('centsNeedle');
  const clamped = Math.max(-50, Math.min(50, roundedCents));
  needle.style.left = ((clamped + 50) / 100 * 280 - 1.5) + 'px';
  needle.className = 'cents-needle' + (Math.abs(roundedCents) <= 8 ? ' good' : (Math.abs(roundedCents) <= 25 ? ' warn' : ''));

  const qtoneHint = document.getElementById('qtoneHint');
  if(Math.abs(roundedCents) >= 38){
    const nextIdx = (noteIdx + (roundedCents>0?1:-1) + 12) % 12;
    qtoneHint.classList.add('show');
    qtoneHint.innerHTML = '🔵 ربع\u200Cپرده — بین «' + NOTE_NAMES_FA[noteIdx] + '» و «' + NOTE_NAMES_FA[nextIdx] + '»';
  } else {
    qtoneHint.classList.remove('show');
  }

  const dbg = document.getElementById('debugLine');
  if(dbg && freq) dbg.textContent = freq.toFixed(1) + ' Hz';
}
function displayIdle(){
  document.getElementById('idleMsg').style.display = 'block';
  document.getElementById('bigNote').textContent = '\u2014';
  document.getElementById('bigCents').innerHTML = '&nbsp;';
  document.getElementById('qtoneHint').classList.remove('show');
  octaveRow.querySelectorAll('span').forEach(s=>s.classList.remove('active'));
  letterRow.querySelectorAll('span').forEach(s=>s.classList.remove('active'));
  persianRow.querySelectorAll('span').forEach(s=>s.classList.remove('active'));
  setActivePianoKey(-1);
  const dbg = document.getElementById('debugLine');
  if(dbg) dbg.textContent = '';
}
displayIdle();

// ══════════════════════════════════════════════════════════
//   هسته تیونر — AudioWorklet + YIN با Overlap
//   معماری: Mic → ScriptProcessor/Worklet → ring buffer
//           → YIN هر 512 نمونه (overlap 75%) → UI update
// ══════════════════════════════════════════════════════════

let micStream = null;
let micAudioCtx = null;
let micRunning = false;
const micBtn = document.getElementById('micBtn');
const micStatus = document.getElementById('micStatus');

// ── پارامترهای تیونر (الهام از TarsosDSP) ──
const TUNER_BUFFER = 2048;     // اندازه بافر YIN
const TUNER_HOP    = 512;      // هر 512 نمونه = overlap 75%
const RMS_THRESHOLD = 0.008;   // حداقل ولوم صدا

// ── YIN pitch detection (بهینهشده) ──
function yinDetect(buf, sampleRate){
  // RMS gate
  let rmsSum = 0;
  for(let i = 0; i < buf.length; i++) rmsSum += buf[i] * buf[i];
  if(Math.sqrt(rmsSum / buf.length) < RMS_THRESHOLD) return -1;

  const halfLen = buf.length >>> 1;
  const tauMin  = Math.max(2, Math.floor(sampleRate / 1400));
  const tauMax  = Math.min(halfLen - 1, Math.floor(sampleRate / 60));

  // Step 2 — difference function
  const d = new Float32Array(tauMax + 1);
  for(let tau = 1; tau <= tauMax; tau++){
    let s = 0;
    for(let i = 0; i < halfLen; i++){
      const v = buf[i] - buf[i + tau];
      s += v * v;
    }
    d[tau] = s;
  }

  // Step 3 — CMNDF
  const cmnd = new Float32Array(tauMax + 1);
  cmnd[0] = 1;
  let runSum = 0;
  for(let tau = 1; tau <= tauMax; tau++){
    runSum += d[tau];
    cmnd[tau] = runSum > 0 ? (d[tau] * tau) / runSum : 1;
  }

  // Step 4 — adaptive threshold (0.10 → 0.25 رو به بالا)
  let bestTau = -1;
  for(let th = 0.10; th <= 0.25; th += 0.025){
    for(let tau = tauMin; tau < tauMax - 1; tau++){
      if(cmnd[tau] < th){
        while(tau + 1 < tauMax && cmnd[tau + 1] < cmnd[tau]) tau++;
        bestTau = tau;
        break;
      }
    }
    if(bestTau !== -1) break;
  }
  // اگر هیچ threshold ای موفق نشد — minimum مطلق
  if(bestTau === -1){
    let minVal = Infinity;
    for(let tau = tauMin; tau < tauMax; tau++){
      if(cmnd[tau] < minVal){ minVal = cmnd[tau]; bestTau = tau; }
    }
    if(minVal > 0.45) return -1;
  }

  // Step 5 — parabolic interpolation
  let refined = bestTau;
  if(bestTau > 1 && bestTau < tauMax - 1){
    const s0 = cmnd[bestTau - 1], s1 = cmnd[bestTau], s2 = cmnd[bestTau + 1];
    const denom = 2 * (2 * s1 - s2 - s0);
    if(Math.abs(denom) > 1e-12)
      refined = bestTau + (s0 - s2) / denom;
  }

  const freq = sampleRate / refined;
  return (freq >= 60 && freq <= 1400) ? freq : -1;
}

// ── Ring Buffer با overlap — مثل AudioDispatcher جاوا ──
class RingYinProcessor {
  constructor(bufSize, hopSize, sampleRate, onPitch){
    this.bufSize = bufSize;
    this.hopSize = hopSize;
    this.sampleRate = sampleRate;
    this.onPitch = onPitch;
    this.ring = new Float32Array(bufSize);
    this.writePos = 0;
    this.filled = false; // آیا حداقل یک بافر کامل داریم
  }

  // دادههای جدید از میکروفون را وارد ring buffer کن
  feed(input){
    for(let i = 0; i < input.length; i++){
      this.ring[this.writePos] = input[i];
      this.writePos++;

      if(this.writePos >= this.bufSize){
        // بافر پر شد — YIN اجرا کن
        this.filled = true;
        this._process();
        // overlap: شیفت (کپی hop آخر را به ابتدا — مثل TarsosDSP)
        const overlap = this.bufSize - this.hopSize;
        this.ring.copyWithin(0, this.hopSize, this.bufSize);
        this.writePos = overlap;
      }
    }
  }

  _process(){
    if(!this.filled) return;
    const freq = yinDetect(this.ring, this.sampleRate);
    this.onPitch(freq);
  }
}

// ── UI update logic (سبکتر از قبل) ──
const CONFIRM_FRAMES = 1;    // فوری (قبل: ۲)
const CENTS_SMOOTH   = 2;    // میانگین ۲ (قبل: ۴)
const SILENCE_MS     = 1500; // ۱.۵ ثانیه (قبل: ۳)

let debounceMidi  = -1;
let debounceCount = 0;
let centsHistory  = [];
let lastSoundTime = 0;
let silenceTimer  = null;

function handlePitch(freq){
  if(!micRunning) return;

  if(freq > 0 && isFinite(freq)){
    lastSoundTime = Date.now();
    if(silenceTimer){ clearTimeout(silenceTimer); silenceTimer = null; }

    const midi    = 69 + 12 * Math.log2(freq / 440);
    const rounded = Math.round(midi);
    const cents   = (midi - rounded) * 100;

    if(rounded === debounceMidi){
      debounceCount++;
      centsHistory.push(cents);
      if(centsHistory.length > CENTS_SMOOTH) centsHistory.shift();
      const smoothCents = centsHistory.reduce((a,b)=>a+b,0) / centsHistory.length;

      if(debounceCount >= CONFIRM_FRAMES){
        const noteIdx = ((rounded % 12) + 12) % 12;
        const octave  = Math.floor(rounded / 12) - 1;
        displayNote(noteIdx, octave, smoothCents, freq);
      }
    } else {
      debounceMidi  = rounded;
      debounceCount = 1;
      centsHistory  = [cents];
    }

  } else {
    if(!silenceTimer && (Date.now() - lastSoundTime) > 300){
      silenceTimer = setTimeout(()=>{
        debounceMidi  = -1;
        debounceCount = 0;
        centsHistory  = [];
        silenceTimer  = null;
        displayIdle();
      }, SILENCE_MS);
    }
  }
}

// ══════════ شروع/توقف تیونر ══════════
let scriptNode = null;
let ringProcessor = null;

function errorAdvice(errName){
  if(errName === 'NotReadableError'){
    return 'میکروفون شناسایی شد ولی سیستم اجازه خواندن نداد. '
      + '(۱) برنامهٔ دیگری میکروفون را قفل کرده — آن را ببندید. '
      + '(۲) تنظیمات ← برنامهها ← مجوزها ← میکروفون را فعال کنید. '
      + '(۳) گوشی را ریاستارت کنید.';
  }
  if(errName === 'NotAllowedError' || errName === 'PermissionDeniedError'){
    return 'دسترسی میکروفون رد شده. تنظیمات ← برنامهها ← مجوزها ← «میکروفون» را فعال کنید.';
  }
  if(errName === 'NotFoundError' || errName === 'DevicesNotFoundError'){
    return 'هیچ میکروفونی شناسایی نشد.';
  }
  return 'خطای نامشخص — لطفاً دوباره تلاش کنید.';
}

async function startTuner(){
  if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    micStatus.innerHTML = '❌ این WebView از میکروفون پشتیبانی نمیکند.';
    return;
  }
  micStatus.textContent = '⏳ درخواست دسترسی میکروفون...';

  // تلاش برای گرفتن میکروفون بدون پردازشهای اضافی
  const constraintsToTry = [
    {audio:{echoCancellation:false, noiseSuppression:false, autoGainControl:false}},
    {audio:true}
  ];
  let lastErr = null;
  for(const c of constraintsToTry){
    try{
      micStream = await navigator.mediaDevices.getUserMedia(c);
      lastErr = null;
      break;
    }catch(err){
      lastErr = err;
    }
  }
  if(lastErr){
    const name = lastErr.name || 'خطا';
    micStatus.innerHTML = '❌ ' + name
      + '<br><span style="color:#aaa">' + errorAdvice(name) + '</span>'
      + '<br><button style="margin-top:10px;border:none;background:#e91e63;color:#fff;border-radius:20px;padding:6px 16px;font-size:.82em;cursor:pointer" onclick="startTuner()">🔁 تلاش دوباره</button>';
    return;
  }

  micAudioCtx = new (window.AudioContext||window.webkitAudioContext)();
  const source = micAudioCtx.createMediaStreamSource(micStream);
  const sr = micAudioCtx.sampleRate;

  micStatus.textContent = '';

  // ── ساخت ring buffer processor ──
  ringProcessor = new RingYinProcessor(TUNER_BUFFER, TUNER_HOP, sr, handlePitch);

  // ── ScriptProcessorNode برای گرفتن نمونهها ──
  // (AudioWorklet ایدهآلتر است ولی ScriptProcessor سازگاری بیشتری دارد)
  // hopSize=512 → نزدیکترین scriptProcessor bufferSize
  // ScriptProcessor bufferSize must be power of 2: 256, 512, 1024...
  scriptNode = micAudioCtx.createScriptProcessor(512, 1, 1);
  scriptNode.onaudioprocess = function(e){
    if(!micRunning) return;
    const input = e.inputBuffer.getChannelData(0);
    ringProcessor.feed(input);
  };

  source.connect(scriptNode);
  scriptNode.connect(micAudioCtx.destination); // لازم برای فعال نگه داشتن

  micRunning = true;
  micBtn.classList.add('on');
  micBtn.textContent = '⏹️ توقف تیونر';
}

function stopTuner(){
  micRunning = false;
  if(silenceTimer){ clearTimeout(silenceTimer); silenceTimer = null; }
  if(scriptNode){ scriptNode.disconnect(); scriptNode = null; }
  if(micStream){ micStream.getTracks().forEach(t=>t.stop()); micStream = null; }
  if(micAudioCtx){ micAudioCtx.close(); micAudioCtx = null; }
  ringProcessor = null;
  debounceMidi = -1; debounceCount = 0; centsHistory = [];
  micBtn.classList.remove('on');
  micBtn.textContent = '🎙️ شروع تیونر';
  displayIdle();
}

micBtn.onclick = function(){
  if(micRunning){ stopTuner(); } else { startTuner(); }
};
</script>
</body>
</html>
