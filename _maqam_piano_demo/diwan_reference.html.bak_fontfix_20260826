<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>جدول کامل دیوان — ۲ اکتاو سُلم موسیقی عربی</title>
<style>
  *{box-sizing:border-box;font-family:Tahoma,"Segoe UI",sans-serif}
  body{margin:0;background:#0f0f1a;color:#eee;min-height:100vh;display:flex;justify-content:center}
  .app{width:100%;max-width:440px;background:#16213e;min-height:100vh;padding-bottom:30px}
  .header{background:linear-gradient(135deg,#3d2b00,#5d4200);color:#fff;padding:18px 20px;text-align:center;box-shadow:0 3px 12px rgba(0,0,0,.3)}
  .header h1{font-size:1.1em;margin:0}
  .header .sub{font-size:.78em;opacity:.75;margin-top:4px;line-height:1.6}
  .backbtn{display:inline-block;margin-top:10px;background:rgba(255,255,255,.15);color:#fff;border:none;border-radius:20px;padding:6px 16px;font-size:.78em;cursor:pointer}

  .card{background:#fff;color:#222;border-radius:16px;margin:14px;padding:16px;box-shadow:0 8px 26px rgba(0,0,0,.35)}
  .card h2{font-size:1em;margin:0 0 8px;color:#1a1a2e;text-align:center}
  .card .sub{font-size:.78em;color:#888;text-align:center;margin-bottom:10px;line-height:1.7}

  .diwan-title{font-size:.9em;font-weight:bold;color:#1a1a2e;background:#f5f0e0;padding:8px 12px;border-radius:8px 8px 0 0;text-align:center}
  ul.fulllist{margin:0;padding:0;list-style:none;font-size:.82em;border-radius:0 0 10px 10px;overflow:hidden;border:1px solid #eee}
  ul.fulllist li{display:flex;align-items:center;justify-content:space-between;padding:7px 10px;background:#fafafa;border-bottom:1px solid #f0f0f0}
  ul.fulllist li:nth-child(even){background:#fff}
  ul.fulllist li:last-child{border-bottom:none}
  ul.fulllist li.is-rast{background:#fff3e0}
  ul.fulllist li.is-rast .nm{color:#c99b1f}
  ul.fulllist li.low-conf{background:#ffebee}
  ul.fulllist .idxchip{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:50%;background:#ddd;color:#555;font-size:.7em;margin-left:8px}
  ul.fulllist .nm{font-weight:bold;color:#1a1a2e}
  ul.fulllist .west{color:#999;font-size:.85em}
  ul.fulllist .flag{color:#c62828;font-size:.85em;margin-right:4px}

  .legend-conf{display:flex;gap:10px;justify-content:center;margin:10px 0;font-size:.72em;flex-wrap:wrap}
  .legend-conf span{padding:3px 8px;border-radius:8px}
  .lc-high{background:#e8f5e9;color:#1b5e20}
  .lc-low{background:#ffebee;color:#b71c1c}

  .staffwrap{overflow-x:auto;-webkit-overflow-scrolling:touch;background:#faf8f2;border-radius:10px;padding:12px 6px;margin-top:6px}

  .note-box{background:#e3f2fd;color:#01579b;font-size:.76em;padding:12px 14px;border-radius:10px;margin:14px;line-height:1.8}
  .warn-box{background:#fff3e0;border:1.5px solid #ff9800;color:#7a3e00;font-size:.74em;padding:12px 14px;border-radius:10px;margin:14px;line-height:1.8}
  .src-box{background:#fff8e1;border:1.5px solid #ffca28;color:#5d4200;font-size:.7em;padding:10px 12px;border-radius:10px;margin:14px;line-height:1.7}
</style>
</head>
<body>
<div class="app">
  <div class="header">
    <h1>📖 جدول کامل دیوان</h1>
    <div class="sub">تمام ۴۹ پرده/ربعپرده سُلم موسیقی عربی — ۲ اکتاو کامل<br>از یکاه تا جواب نوا</div>
    <button class="backbtn" onclick="history.back()">← بازگشت</button>
  </div>

  <div class="warn-box">
    ✅ <b>بازبینی نهایی انجام شد (۲۰۲۶/۰۶/۰۳):</b> با دو تصویر روشن و رسمی (جدول اصوات + نتنویسی دیوان اول/دوم) که شما ارسال کردید، تمام ۴۹ نام بازبینی و اصلاح شد. <b>۵ اصلاح واقعی</b> نسبت به نسخهی قبلی: «نفیر» → <b>«نفت»</b> برگردانده شد (اصلاح قبلی من اشتباه بود)، «حسینیعشیران» → <b>«حسینی شذ»</b>، «رمَل توتی» (که در جای اشتباه بود) → <b>«ماهوران»</b> در موقعیت درست + «جواب نوا / رمل نوتی» در موقعیت پایانی درست، «بزرگ» → <b>«بزرك»</b> (املای عربی مطابق منبع)، و ترتیب/املای چند نام دیگر («نیمحصار (قرار)»→«قرار نیم حصار») مطابق متن اصلی تصحیح شد.
  </div>

  <div class="card">
    <h2>راهنمای رنگها</h2>
    <div class="legend-conf">
      <span class="lc-high">🟢 نام استاندارد و پرکاربرد — اطمینان بالا</span>
      <span class="lc-low">🔴 ⚠️ نیاز به بازبینی مجدد با تصویر بهتر</span>
    </div>
  </div>

  <div class="card">
    <h2>🎼 نمایش تقریبی نتنویسی — دیوان اول</h2>
    <div class="sub">این یک شبیهسازی ساده است (نه نتنویسی دقیق حرفهای) — فقط برای درک بصری موقعیت نسبی هر پرده</div>
    <div class="staffwrap"><svg id="staff1" height="170"></svg></div>
  </div>

  <div class="card">
    <h2>🎼 نمایش تقریبی نتنویسی — دیوان دوم</h2>
    <div class="staffwrap"><svg id="staff2" height="170"></svg></div>
  </div>

  <div class="card">
    <h2>📋 لیست کامل — دیوان اول (یکاه تا پیش از نوا)</h2>
    <ul class="fulllist" id="diwan1"></ul>
  </div>

  <div class="card">
    <h2>📋 لیست کامل — دیوان دوم (نوا تا جواب نوا)</h2>
    <ul class="fulllist" id="diwan2"></ul>
  </div>

  <div class="note-box">
    🎼 «راست» (ردیف زردرنگ، دو۴) پایهٔ محاسبهٔ کل جدول است. روی هر ردیف کلیک کنید تا صدایش را بشنوید.
  </div>

  <div class="src-box">
    🔎 <b>منبع:</b> جدول تاریخی دکتر میخائیل مشاقّه، نقلشده در مقالهٔ «مقامیة الموسیقا العربیة» — محمد قدری دلال (maaber.org).
  </div>
</div>

<script>
function toFa(n){ return n.toString().replace(/[0-9]/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]); }

const WEST_NAMES_BASE = ['دو','دو#/ربمل','ر','ر#/می‌بمل','می','فا','فا#/سل‌بمل','سل','سل#/لابمل','لا','لا#/سی‌بمل','سی'];
function westName(offset){
  const oct = Math.floor(offset/12);
  const local = ((offset%12)+12)%12;
  if(Number.isInteger(local)) return WEST_NAMES_BASE[local] + (oct!==0 ? (oct>0?'+'+oct:oct) : '');
  const lo = WEST_NAMES_BASE[Math.floor(local)];
  return 'ربعپرده نزدیک '+lo;
}

// نام اصیل هر پرده — بازبینی نهایی بر اساس دو تصویر رسمی (جدول اصوات + نتنویسی شمارهگذاریشدهی دیوان اول/دوم)
// سطح اطمینان: true = تأییدشده با منبع رسمی شمارهگذاریشده
const AUTH_DATA = [
  ['یکاه',true],['قرار نیم حصار',true],['قرار حصار',true],['قرار تیک حصار',true],['عشیران',true],
  ['قرار نیم عجم',true],['قرار عجم',true],['عراق',true],['کوشت',true],['تیک کوشت',true],
  ['راست',true],['نیم زرکولا',true],['زرکولا',true],['تیک زرکولا',true],['دوکاه',true],
  ['نیم کرد',true],['کرد',true],['سیکاه',true],['بوسلیک',true],['تیک بوسلیک',true],
  ['جهارکاه',true],['نیم حجاز (عربیه)',true],['حجاز / صبا',true],['تیک حجاز',true],['نوا',true],
  ['نیم حصار',true],['حصار (شوری)',true],['تیک حصار',true],['حسینی',true],['نیم عجم',true],
  ['عجم / نیرز',true],['أوج',true],['نفت',true],['تیک نفت',true],['کردان / ماهور',true],
  ['نیم شاهناز (کُناز)',true],['شاهناز',true],['تیک شاهناز',true],['محیّر (مخیّر)',true],['نیم زوال',true],
  ['زوال / سنبله',true],['بزرک',true],['حسینی شذ',true],['تیک حسینی شذ',true],['ماهوران',true],
  ['جواب نیم حجاز',true],['جواب حجاز',true],['جواب تیک حجاز',true],['جواب نوا (رمل نوتی)',true]
];
const FULL_TABLE=[];
for(let i=0;i<49;i++){
  const off=-5+i*0.5;
  FULL_TABLE.push({idx:i, off:off, auth:AUTH_DATA[i][0], conf:AUTH_DATA[i][1], west:westName(off)});
}

let audioCtx=null;
function ensureCtx(){
  if(!audioCtx) audioCtx=new (window.AudioContext||window.webkitAudioContext)();
  if(audioCtx.state==='suspended') audioCtx.resume();
  return audioCtx;
}
// ── سنتز شبیه صدای انسان (مرد) — ارتعاش پایه + دو فرمنت واکهی «آ» + پاکت طبیعی ──
function playFreq(freq){
  const ctx=ensureCtx();
  const now=ctx.currentTime;

  const osc=ctx.createOscillator();
  osc.type='sawtooth'; // هارمونیکهای بیشتر نسبت به triangle، نزدیکتر به تار صوتی انسان
  osc.frequency.value=freq;

  // وایبراتوی طبیعی (لرزش خفیف صدا)
  const vibrato=ctx.createOscillator(); vibrato.frequency.value=5.3;
  const vibratoGain=ctx.createGain(); vibratoGain.gain.value=4;
  vibrato.connect(vibratoGain); vibratoGain.connect(osc.frequency);

  // فرمنتهای صدای مرد برای واکهی «آ» (F1≈730هرتز، F2≈1090هرتز)
  const f1=ctx.createBiquadFilter(); f1.type='bandpass'; f1.frequency.value=730;  f1.Q.value=9;
  const f2=ctx.createBiquadFilter(); f2.type='bandpass'; f2.frequency.value=1090; f2.Q.value=11;
  const g1=ctx.createGain(); g1.gain.value=1.0;
  const g2=ctx.createGain(); g2.gain.value=0.55;

  const master=ctx.createGain();
  master.gain.setValueAtTime(0.0001, now);
  master.gain.exponentialRampToValueAtTime(0.5, now+0.07);
  master.gain.exponentialRampToValueAtTime(0.38, now+0.35);
  master.gain.exponentialRampToValueAtTime(0.0001, now+1.3);

  osc.connect(f1); f1.connect(g1); g1.connect(master);
  osc.connect(f2); f2.connect(g2); g2.connect(master);
  master.connect(ctx.destination);

  osc.start(); vibrato.start();
  osc.stop(now+1.35); vibrato.stop(now+1.35);
}

function renderDiwan(containerId, fromIdx, toIdx){
  const ul=document.getElementById(containerId); ul.innerHTML='';
  for(let i=fromIdx;i<=toIdx;i++){
    const pt=FULL_TABLE[i];
    const li=document.createElement('li');
    let cls = pt.off===0 ? 'is-rast' : '';
    if(!pt.conf) cls += ' low-conf';
    li.className = cls.trim();
    const flag = pt.conf ? '' : '<span class="flag">⚠️</span>';
    li.innerHTML='<span><span class="idxchip">'+toFa(i)+'</span>'+flag+'<span class="nm">'+pt.auth+'</span></span><span class="west">'+pt.west+'</span>';
    li.style.cursor='pointer';
    li.onclick=()=>{ ensureCtx(); playFreq(261.626*Math.pow(2,pt.off/12)); };
    ul.appendChild(li);
  }
}
renderDiwan('diwan1', 0, 23);
renderDiwan('diwan2', 24, 48);

// ══════════ نمایش تقریبی نتنویسی (SVG) ══════════
// این یک شبیهسازی ساده است: فاصلهی عمودی هر نُت متناسب با فاصلهی نیمپردهایاش از خط سوم حامل (فرض: راست/کردان روی خط سوم)
function drawStaff(svgId, fromIdx, toIdx, refOffset){
  const svg = document.getElementById(svgId);
  const stepPx = 5; // فاصلهی عمودی هر نیمپرده (px) — تقریبی، نه دقیق حرفهای
  const startX = 30, gapX = 34;
  const width = startX + (toIdx-fromIdx+1)*gapX + 20;
  svg.setAttribute('width', width);
  svg.setAttribute('viewBox', '0 0 '+width+' 170');
  const midY = 85; // خط سوم حامل = مرجع (رفOffset)

  let html = '';
  // ۵ خط حامل
  for(let l=0;l<5;l++){
    const y = midY - 40 + l*20;
    html += '<line x1="10" y1="'+y+'" x2="'+(width-10)+'" y2="'+y+'" stroke="#333" stroke-width="1.2"/>';
  }
  // علامت کلید سل (نمایشی)
  html += '<text x="12" y="'+(midY+18)+'" font-size="48" fill="#333">𝄞</text>';

  for(let i=fromIdx;i<=toIdx;i++){
    const pt = FULL_TABLE[i];
    const semisFromRef = pt.off - refOffset;
    const y = midY - semisFromRef*stepPx;
    const x = startX + (i-fromIdx)*gapX;

    // خطوط اضافه (ledger lines) اگر بیرون از حامل باشد
    const topLine = midY-40, botLine = midY+40;
    if(y < topLine){
      for(let ly = topLine-20; ly>=y-2; ly-=20){
        html += '<line x1="'+(x-9)+'" y1="'+ly+'" x2="'+(x+9)+'" y2="'+ly+'" stroke="#333" stroke-width="1"/>';
      }
    } else if(y > botLine){
      for(let ly = botLine+20; ly<=y+2; ly+=20){
        html += '<line x1="'+(x-9)+'" y1="'+ly+'" x2="'+(x+9)+'" y2="'+ly+'" stroke="#333" stroke-width="1"/>';
      }
    }

    const isQuarter = !Number.isInteger(pt.off);
    const fillColor = pt.off===0 ? '#c99b1f' : (isQuarter ? '#b71c1c' : '#1a1a2e');
    html += '<ellipse cx="'+x+'" cy="'+y+'" rx="6" ry="4.5" fill="'+fillColor+'" transform="rotate(-18 '+x+' '+y+')"/>';
    if(isQuarter){
      html += '<text x="'+(x-16)+'" y="'+(y+4)+'" font-size="11" fill="#b71c1c" font-weight="bold">d</text>'; // نماد تقریبی نیمبمل (کوارتر تون)
    }
    // نام زیر نت — چرخانده برای خوانایی
    html += '<text x="'+x+'" y="155" font-size="9" fill="#555" text-anchor="middle" transform="rotate(-40 '+x+' 150)">'+pt.auth+'</text>';
  }
  svg.innerHTML = html;
}
// دیوان اول: مرجع = راست (idx10, offset0) روی خط سوم
drawStaff('staff1', 0, 23, 0);
// دیوان دوم: مرجع = نوا (idx24, offset7) — برای اینکه در محدودهی معقول حامل بماند
drawStaff('staff2', 24, 48, 7);
</script>
</body>
</html>
